<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Intentionally no READ_MEDIA_IMAGES / storage permission. The picker MUST grant access. -->
    <!-- Local HTTP test receiver only; never included in Image Order APK. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.twobornot.imageorder" />
        <intent><action android:name="android.intent.action.GET_CONTENT" /><data android:mimeType="*/*" /></intent>
    </queries>
    <application android:label="External Picker Caller Test" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="true">
        <activity android:name=".AttachmentCallerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Test-only independent UID HTML file input / WebChromeClient caller. -->
        <activity android:name=".WebUploadCallerActivity" android:exported="false" />
    </application>
</manifest>
