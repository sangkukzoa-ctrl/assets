<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Intentionally no READ_MEDIA_IMAGES / storage permission. The picker MUST grant access. -->
    <queries><package android:name="com.twobornot.imageorder" /></queries>
    <application android:label="External Picker Caller Test" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
        <activity android:name=".AttachmentCallerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Test-only independent UID HTML file input / WebChromeClient caller. -->
        <activity android:name=".WebUploadCallerActivity" android:exported="false" />
    </application>
</manifest>
